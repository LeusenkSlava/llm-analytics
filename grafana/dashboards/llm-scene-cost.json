      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH\nnovels AS (\n    SELECT entity_id\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n),\nscene_ops AS (\n    SELECT\n        entity_id,\n        operation,\n        splitByChar('_', operation) AS parts\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND scene_order > 0\n        AND $__timeFilter(ts)\n    GROUP BY entity_id, operation, parts\n),\nroadmap_base AS (\n    SELECT\n        entity_id,\n        minIf(toUInt32OrZero(parts[2]), length(parts) = 3) AS base_roadmap\n    FROM scene_ops\n    GROUP BY entity_id\n),\ntrue_plan AS (\n    SELECT\n        entity_id,\n        length(JSONExtractArrayRaw(response, 'roadmap')) AS steps\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND step = 'RoadmapGenerator'\n        AND response != ''\n    ORDER BY ts ASC\n    LIMIT 1 BY entity_id\n),\ntrue_scenes AS (\n    SELECT\n        o.entity_id AS entity_id,\n        o.operation AS operation\n    FROM scene_ops AS o\n    LEFT JOIN roadmap_base AS b ON b.entity_id = o.entity_id\n    LEFT JOIN true_plan AS t ON t.entity_id = o.entity_id\n    WHERE length(o.parts) <> 3\n        OR ifNull(t.steps, 0) = 0\n        OR toUInt32OrZero(o.parts[2]) < b.base_roadmap + t.steps\n),\nscene_text AS (\n    SELECT\n        entity_id,\n        operation,\n        argMax(\n            concat(\n                JSONExtractString(response, 'title'),\n                ' ',\n                JSONExtractString(response, 'description')\n            ),\n            ts\n        ) AS text\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND step = 'SceneGenerator'\n        AND scene_order > 0\n        AND response != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id, operation\n),\ndialogue_text AS (\n    SELECT\n        entity_id,\n        operation,\n        argMax(\n            arrayStringConcat(\n                arrayMap(\n                    x -> JSONExtractString(x, 'text'),\n                    JSONExtractArrayRaw(response, 'dialogue_lines')\n                ),\n                ' '\n            ),\n            ts\n        ) AS text\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND step = 'DialogueGenerator'\n        AND scene_order > 0\n        AND response != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id, operation\n),\nall_text AS (\n    SELECT entity_id, operation, length(splitByNonAlpha(text)) AS words FROM scene_text\n    UNION ALL\n    SELECT entity_id, operation, length(splitByNonAlpha(text)) AS words FROM dialogue_text\n),\nnovel_words AS (\n    SELECT\n        a.entity_id AS entity_id,\n        sum(a.words) AS words\n    FROM all_text AS a\n    INNER JOIN true_scenes AS t\n        ON t.entity_id = a.entity_id\n        AND t.operation = a.operation\n    GROUP BY a.entity_id\n)\nSELECT\n    toUInt32OrZero(n.entity_id) AS novel,\n    if(w.entity_id = '', NULL, round(w.words / 200, 1)) AS minutes\nFROM novels AS n\nLEFT JOIN novel_words AS w ON w.entity_id = n.entity_id\nORDER BY novel",
          "refId": "A"
        }
      ],
      "title": "Длина новеллы в минутах",
      "type": "trend"
