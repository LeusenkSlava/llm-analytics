          "rawSql": "WITH\nnovels AS (\n    SELECT entity_id\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n)\nSELECT\n    toUInt32OrZero(n.entity_id) AS novel,\n    if(m.entity_id = '', NULL, m.cache_hit_pct) AS cache_hit_pct\nFROM novels AS n\nLEFT JOIN (\n    SELECT\n        entity_id,\n        round(sum(cached_tokens) / greatest(sum(prompt_tokens), 1) * 100, 1) AS cache_hit_pct\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n) AS m ON m.entity_id = n.entity_id\nORDER BY novel",
