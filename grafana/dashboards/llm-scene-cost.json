          "queryType": "table",
          "rawSql": "WITH\nnovels AS (\n    SELECT entity_id\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n)\nSELECT\n    toUInt32OrZero(n.entity_id) AS novel,\n    if(m.entity_id = '', NULL, m.scenes) AS scenes\nFROM novels AS n\nLEFT JOIN (\n    SELECT\n        entity_id,\n        uniqExact(operation) AS scenes\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND scene_order > 0\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n) AS m ON m.entity_id = n.entity_id\nORDER BY novel",
