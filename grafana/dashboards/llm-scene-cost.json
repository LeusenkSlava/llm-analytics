          "queryType": "table",
          "rawSql": "WITH\nnovels AS (\n    SELECT entity_id\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n)\nSELECT\n    toUInt32OrZero(n.entity_id) AS novel,\n    if(m.entity_id = '', NULL, m.scene_retries) AS scene_retries,\n    if(m.entity_id = '', NULL, m.validator_extra) AS validator_extra,\n    if(m.entity_id = '', NULL, m.dialogue_extra) AS dialogue_extra,\n    if(m.entity_id = '', NULL, m.context_extra) AS context_extra\nFROM novels AS n\nLEFT JOIN (\n    SELECT\n        entity_id,\n        sumIf(calls - 1, step = 'SceneGenerator') AS scene_retries,\n        sumIf(calls - 1, step = 'SceneRoadmapValidator') AS validator_extra,\n        sumIf(calls - 1, step = 'DialogueGenerator') AS dialogue_extra,\n        sumIf(calls - 1, step = 'StoryContextGenerator') AS context_extra\n    FROM (\n        SELECT\n            entity_id,\n            scene_order,\n            step,\n            count() AS calls\n        FROM analytics.llm_calls FINAL\n        WHERE entity_id != ''\n            AND scene_order > 0\n            AND $__timeFilter(ts)\n        GROUP BY entity_id, scene_order, step\n    )\n    GROUP BY entity_id\n) AS m ON m.entity_id = n.entity_id\nORDER BY novel",
          "refId": "A"
        }
