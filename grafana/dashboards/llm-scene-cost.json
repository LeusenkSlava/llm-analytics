      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    toUInt32OrZero(entity_id) AS novel,\n    round(avg(scene_tokens)) AS avg_tokens_per_scene\nFROM (\n    SELECT\n        entity_id,\n        scene_order,\n        sum(prompt_tokens + completion_tokens) AS scene_tokens\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND scene_order > 0\n        AND $__timeFilter(ts)\n    GROUP BY entity_id, scene_order\n)\nGROUP BY entity_id\nORDER BY novel",
          "refId": "A"
        }
      ],
