      "pluginVersion": "12.2.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH roads AS (\n    SELECT\n        entity_id,\n        JSONExtractArrayRaw(response, 'roadmap') AS arr\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND step = 'RoadmapGenerator'\n        AND $__timeFilter(ts)\n    ORDER BY ts DESC\n    LIMIT 1 BY entity_id\n),\nplanned AS (\n    SELECT\n        entity_id,\n        arraySum(arrayMap(x -> JSONExtractInt(x, 'scenes_count'), arr)) AS planned_scenes\n    FROM roads\n),\nactual_scenes AS (\n    SELECT\n        entity_id,\n        max(scene_order) AS scenes\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND scene_order > 0\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n),\nfinished AS (\n    SELECT a.entity_id\n    FROM actual_scenes AS a\n    INNER JOIN planned AS p ON a.entity_id = p.entity_id\n    WHERE a.scenes >= p.planned_scenes\n),\nscene_text AS (\n    SELECT\n        entity_id,\n        scene_order,\n        argMax(\n            concat(\n                JSONExtractString(response, 'title'),\n                ' ',\n                JSONExtractString(response, 'description')\n            ),\n            ts\n        ) AS text\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND step = 'SceneGenerator'\n        AND scene_order > 0\n        AND response != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id, scene_order\n),\ndialogue_text AS (\n    SELECT\n        entity_id,\n        scene_order,\n        argMax(\n            arrayStringConcat(\n                arrayMap(\n                    x -> JSONExtractString(x, 'text'),\n                    JSONExtractArrayRaw(response, 'dialogue_lines')\n                ),\n                ' '\n            ),\n            ts\n        ) AS text\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND step = 'DialogueGenerator'\n        AND scene_order > 0\n        AND response != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id, scene_order\n),\nall_text AS (\n    SELECT entity_id, scene_order, text FROM scene_text\n    UNION ALL\n    SELECT entity_id, scene_order, text FROM dialogue_text\n)\nSELECT\n    toUInt32OrZero(entity_id) AS novel,\n    round(sum(length(splitByNonAlpha(text))) / 200, 1) AS minutes\nFROM all_text\nWHERE entity_id IN (SELECT entity_id FROM finished)\nGROUP BY entity_id\nORDER BY novel",
          "refId": "A"
        }
      ],
      "title": "Длина законченной новеллы в минутах",
      "type": "trend"
    }
