        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH roads AS (\n    SELECT\n        entity_id,\n        JSONExtractArrayRaw(response, 'roadmap') AS arr\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND step = 'RoadmapGenerator'\n        AND $__timeFilter(ts)\n    ORDER BY ts DESC\n    LIMIT 1 BY entity_id\n),\nplanned AS (\n    SELECT\n        entity_id,\n        arraySum(arrayMap(x -> JSONExtractInt(x, 'scenes_count'), arr)) AS planned_scenes\n    FROM roads\n),\nscenes AS (\n    SELECT\n        entity_id,\n        max(scene_order) AS scenes\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND scene_order > 0\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n)\nSELECT\n    toUInt32OrZero(s.entity_id) AS novel,\n    s.scenes\nFROM scenes AS s\nINNER JOIN planned AS p ON s.entity_id = p.entity_id\nWHERE s.scenes >= p.planned_scenes\nORDER BY novel",
          "refId": "A"
        }
      ],
