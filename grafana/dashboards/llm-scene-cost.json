      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH\nnovels AS (\n    SELECT entity_id\n    FROM analytics.llm_calls FINAL\n    WHERE entity_id != ''\n        AND $__timeFilter(ts)\n    GROUP BY entity_id\n)\nSELECT\n    toUInt32OrZero(n.entity_id) AS novel,\n    if(m.entity_id = '', NULL, m.avg_tokens_per_scene) AS avg_tokens_per_scene,\n    if(m.entity_id = '', NULL, m.avg_reasoning_per_scene) AS avg_reasoning_per_scene\nFROM novels AS n\nLEFT JOIN (\n    SELECT\n        entity_id,\n        avg(scene_tokens) AS avg_tokens_per_scene,\n        if(sum(scene_reasoning) = 0, NULL, avg(scene_reasoning)) AS avg_reasoning_per_scene\n    FROM (\n        SELECT\n            entity_id,\n            scene_order,\n            sum(prompt_tokens + completion_tokens) AS scene_tokens,\n            sum(reasoning_tokens) AS scene_reasoning\n        FROM analytics.llm_calls FINAL\n        WHERE entity_id != ''\n            AND scene_order > 0\n            AND $__timeFilter(ts)\n        GROUP BY entity_id, scene_order\n    )\n    GROUP BY entity_id\n) AS m ON m.entity_id = n.entity_id\nORDER BY novel",
          "refId": "A"
        }
      ],
      "title": "Средняя цена сцены по новелам, токенов",
      "type": "trend",
      "pluginVersion": "12.2.0"
    },
